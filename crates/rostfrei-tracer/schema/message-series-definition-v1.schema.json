{
  "$id": "https://rostfrei.dev/schemas/tracer/message-series-definition-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rostfrei Tracer Message Series Definition",
  "description": "An ordered sequence of independently rooted causal message graphs.",
  "type": "object",
  "properties": {
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MessageGraphDefinition"
      },
      "minItems": 1
    },
    "settleFor": {
      "$ref": "#/$defs/TimeoutSchema"
    },
    "within": {
      "$ref": "#/$defs/TimeoutSchema"
    }
  },
  "additionalProperties": false,
  "required": [
    "within",
    "settleFor",
    "graphs"
  ],
  "$defs": {
    "AcceptedOutcomeSchema": {
      "type": "string",
      "enum": [
        "accepted"
      ]
    },
    "AggregateSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ]
    },
    "ExpectedMessageNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "aggregate": {
              "$ref": "#/$defs/AggregateSchema"
            },
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "type": "string",
              "const": "command"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "outcome": {
              "$ref": "#/$defs/ExpectedOutcomeSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion",
            "aggregate",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "type": "string",
              "const": "domain-event"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "type": "string",
              "const": "integration-event"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion"
          ]
        }
      ]
    },
    "ExpectedOutcomeSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptedOutcomeSchema"
        },
        {
          "$ref": "#/$defs/RejectedOutcomeSchema"
        }
      ]
    },
    "ExpectedRejectionSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "\\S"
        },
        "payload": true
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "MessageGraphDefinition": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedMessageNode"
          },
          "maxItems": 4096,
          "minItems": 1
        },
        "settleFor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "within": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "nodes"
      ]
    },
    "NonEmptyStringSchema": {
      "type": "string",
      "pattern": "\\S"
    },
    "RejectedOutcomeSchema": {
      "type": "object",
      "properties": {
        "rejected": {
          "$ref": "#/$defs/ExpectedRejectionSchema"
        }
      },
      "additionalProperties": false,
      "required": [
        "rejected"
      ]
    },
    "TimeoutSchema": {
      "type": "string",
      "pattern": "^0*(?:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|60000)ms|(?:[1-9]|[1-5][0-9]|60)s)$"
    }
  }
}
