{
  "$defs": {
    "AcceptedOutcomeSchema": {
      "enum": [
        "accepted"
      ],
      "type": "string"
    },
    "AggregateSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "\\S",
          "type": "string"
        },
        "type": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "BehavioralExpectedSchema": {
      "additionalProperties": false,
      "description": "Exactly one causal graph. Runtime validation additionally enforces root, key, parent, and cycle semantics that JSON Schema cannot express.",
      "properties": {
        "graphs": {
          "items": {
            "$ref": "#/$defs/MessageGraphDefinition"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "settleFor": {
          "$ref": "#/$defs/BehavioralTimeoutSchema"
        },
        "within": {
          "$ref": "#/$defs/BehavioralTimeoutSchema"
        }
      },
      "required": [
        "within",
        "settleFor",
        "graphs"
      ],
      "type": "object"
    },
    "BehavioralTimeoutSchema": {
      "pattern": "^0*(?:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|60000)ms|(?:[1-9]|[1-5][0-9]|60)s)$",
      "type": "string"
    },
    "ExpectedMessageNode": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "aggregate": {
              "$ref": "#/$defs/AggregateSchema"
            },
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "const": "command",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "outcome": {
              "$ref": "#/$defs/ExpectedOutcomeSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion",
            "aggregate",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "const": "domain-event",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "kind": {
              "const": "integration-event",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyStringSchema"
            },
            "parentKey": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonEmptyStringSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": true,
            "schemaVersion": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "key",
            "name",
            "schemaVersion"
          ],
          "type": "object"
        }
      ]
    },
    "ExpectedOutcomeSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptedOutcomeSchema"
        },
        {
          "$ref": "#/$defs/RejectedOutcomeSchema"
        }
      ]
    },
    "ExpectedRejectionSchema": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "\\S",
          "type": "string"
        },
        "payload": true
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "MessageGraphDefinition": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "description": "A causal graph with at most 64 parent-child levels and at most 64 direct children per node. Comparison also has a deterministic work limit for ambiguous assignments.",
          "items": {
            "$ref": "#/$defs/ExpectedMessageNode"
          },
          "maxItems": 4096,
          "minItems": 1,
          "type": "array"
        },
        "settleFor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "within": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nodes"
      ],
      "type": "object"
    },
    "NonEmptyBehavioralStringSchema": {
      "pattern": "\\S",
      "type": "string"
    },
    "NonEmptyStringSchema": {
      "pattern": "\\S",
      "type": "string"
    },
    "RejectedOutcomeSchema": {
      "additionalProperties": false,
      "properties": {
        "rejected": {
          "$ref": "#/$defs/ExpectedRejectionSchema"
        }
      },
      "required": [
        "rejected"
      ],
      "type": "object"
    },
    "TestDefinitionSchemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "TestIdSchema": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "TestSetup": {
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "$ref": "#/$defs/NonEmptyBehavioralStringSchema"
        }
      },
      "required": [
        "fixture"
      ],
      "type": "object"
    },
    "TimeoutSchema": {
      "pattern": "^0*(?:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|60000)ms|(?:[1-9]|[1-5][0-9]|60)s)$",
      "type": "string"
    }
  },
  "$id": "https://rostfrei.dev/schemas/tracer/behavioral-test-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A version 1 typed behavioral test. Runtime validation is authoritative for graph topology, byte-oriented identifier bounds, and the exactly-one-graph behavioral constraint.",
  "properties": {
    "expected": {
      "$ref": "#/$defs/BehavioralExpectedSchema"
    },
    "id": {
      "$ref": "#/$defs/TestIdSchema",
      "not": {
        "const": "validate"
      }
    },
    "name": {
      "$ref": "#/$defs/NonEmptyBehavioralStringSchema"
    },
    "schemaVersion": {
      "$ref": "#/$defs/TestDefinitionSchemaVersion"
    },
    "setup": {
      "$ref": "#/$defs/TestSetup"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "setup",
    "expected"
  ],
  "title": "Rostfrei Tracer Behavioral Test",
  "type": "object"
}
