{
  "name": "@rostfrei/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme.tsx",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./brand": "./src/brand/index.tsx",
    "./brand/*.png": "./src/brand/*.png",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "dev": "vite --config gallery/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8.0.0"
  }
}
