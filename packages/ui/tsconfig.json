{
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "gallery/**/*.ts", "gallery/**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@rostfrei/ui/components/*": ["./src/components/*"],
      "@rostfrei/ui/lib/*": ["./src/lib/*"],
      "@rostfrei/ui/hooks/*": ["./src/hooks/*"]
    }
  }
}
